PROJECT_NAME="PriceTracker"
API_V1_STR="/api/v1"
SECRET_KEY="supersecret_jwt_key_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./pricetracker.db

# Email Alerts (Mailtrap / SMTP configuration - Optional)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=alerts@pricetracker.local
EMAILS_FROM_NAME="PriceTracker Alert"
ENABLE_EMAIL_ALERTS=False

# Scraper Settings
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
SCRAPER_REQUEST_TIMEOUT=15
